═══════════════════════════════════════════════════════════
   🚀 ORCHESTRA SERVICES - ШПАРГАЛКА ПО КОМАНДАМ
═══════════════════════════════════════════════════════════

┌─────────────────────────────────────────────────────────┐
│ 📖 ПЕРВЫЙ ЗАПУСК (один раз)                             │
└─────────────────────────────────────────────────────────┘
  cp .env.example .env        # Создать .env
  nano .env                   # Задать пароли
  make dev                    # Запустить!

┌─────────────────────────────────────────────────────────┐
│ 🔧 РАЗРАБОТКА (Dev)                                     │
└─────────────────────────────────────────────────────────┘
  make dev                    # Запуск с hot-reload
  make stop                   # Остановка
  make logs                   # Просмотр логов
  make logs-back              # Логи бэкенда
  make status                 # Статус контейнеров

  📍 URLs:
     Backend:  http://localhost:3000
     Web:      http://localhost:5173
     Admin:    http://localhost:5174
     Logs:     http://localhost:9999

┌─────────────────────────────────────────────────────────┐
│ 🚀 PRODUCTION                                           │
└─────────────────────────────────────────────────────────┘
  make prod                   # Запуск production
  make restart                # Перезапуск
  make rebuild                # Пересборка
  make stop                   # Остановка

  📍 URLs:
     Web:      http://localhost
     Backend:  http://localhost:3000
     Admin:    http://localhost:8081

┌─────────────────────────────────────────────────────────┐
│ 🚢 ДЕПЛОЙ НА СЕРВЕР                                     │
└─────────────────────────────────────────────────────────┘
  # Автоматический (после настройки GitLab CI/CD):
  git push origin master      # Автодеплой!

  # Ручной:
  make deploy                 # Деплой SSH

  # Настройка CI/CD (один раз):
  1. ssh-keygen -t ed25519 -C "gitlab-ci"
  2. ssh-copy-id root@213.226.126.196
  3. GitLab → Settings → CI/CD → Variables
  4. Добавить SSH_PRIVATE_KEY

┌─────────────────────────────────────────────────────────┐
│ 🗄️  БАЗА ДАННЫХ                                         │
└─────────────────────────────────────────────────────────┘
  make backup-db              # Бэкап БД
  make shell-postgres         # PostgreSQL CLI
  make shell-back             # Shell в бэкенде

┌─────────────────────────────────────────────────────────┐
│ 🐛 TROUBLESHOOTING                                      │
└─────────────────────────────────────────────────────────┘
  make logs                   # Смотреть логи
  make status                 # Проверить статус
  make stop && make dev       # Перезапуск dev
  make rebuild                # Пересборка prod
  docker compose ps           # Все контейнеры
  docker system prune         # Очистка Docker

┌─────────────────────────────────────────────────────────┐
│ 📚 ДОКУМЕНТАЦИЯ                                         │
└─────────────────────────────────────────────────────────┘
  START_HERE.md               # ⭐ Начните здесь!
  QUICKSTART.md               # 🚀 Быстрый старт
  AUTOMATION.md               # 📖 Полное руководство
  README.md                   # 📄 Общая информация
  DEPLOY.md                   # 🚢 Развертывание
  CHANGES.md                  # 📝 Изменения

┌─────────────────────────────────────────────────────────┐
│ ⚡ БЫСТРЫЕ КОМАНДЫ                                       │
└─────────────────────────────────────────────────────────┘
  make help                   # Все команды
  make ps                     # Активные контейнеры
  docker compose logs -f NAME # Логи сервиса
  docker compose restart NAME # Перезапуск сервиса

┌─────────────────────────────────────────────────────────┐
│ 🔐 БЕЗОПАСНОСТЬ                                         │
└─────────────────────────────────────────────────────────┘
  ❗ Не коммитьте .env в Git!
  ❗ Задайте сильные пароли в .env
  ❗ На проде не открывайте порт PostgreSQL
  ✅ Используйте SSH-ключи, не пароли

═══════════════════════════════════════════════════════════
  ✨ ВСЁ АВТОМАТИЗИРОВАНО! ПРОСТО ПИШИТЕ КОД! ✨
