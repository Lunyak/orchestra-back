# Dev-сервер Vite. Контекст сборки — корень репозитория (общий пакет app, как в admin/Dockerfile).
FROM node:22-alpine

WORKDIR /workspace

COPY admin/package.json admin/package-lock.json ./admin/
COPY app/package.json app/package-lock.json ./app/

RUN cd admin && npm ci
RUN cd app && npm ci

COPY admin/vite.config.ts admin/tsconfig.json admin/tsconfig.node.json admin/index.html ./admin/

WORKDIR /workspace/admin

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
