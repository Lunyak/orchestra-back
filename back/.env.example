# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/orchestra?schema=public"

# JWT
JWT_SECRET="your-secret-key-here"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-refresh-secret-here"
JWT_REFRESH_EXPIRES_IN="7d"

# Telegram Bot
BOT_TOKEN="your_telegram_bot_token_from_botfather"
OWNER_TELEGRAM_ID="your_telegram_user_id"

# Bot <-> Backend интеграция
# Секрет для доступа к /bot/* эндпоинтам в backend (передаётся в заголовке Authorization: Bearer ... или X-Bot-Secret)
BOT_SECRET="change-me"

# Внутренний URL bot-сервиса (который умеет публиковать репетиции в чат)
BOT_INTERNAL_URL="http://bot:3001"
# Секрет для вызова bot-сервиса из backend (заголовок X-Internal-Secret)
BOT_INTERNAL_SECRET="change-me-too"

# AWS S3 (optional, for file uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
