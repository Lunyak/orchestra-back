# Prisma 7: локально нужен Node >= 20 (на 18 падает CLI с ERR_REQUIRE_ESM / zeptomatch).
# В каталоге back есть .nvmrc → `nvm use` или поставь Node 22 LTS.

# Database
# Локально к Postgres из docker-compose.yml этого репозитория:
# DATABASE_URL="postgresql://orkestr:orkestr_secret@127.0.0.1:5432/dophamin_orkestr"
# Другой инстанс / пароль — подставь свои user:pass@host:port/dbname
DATABASE_URL="postgresql://postgres:password@localhost:5432/orchestra?schema=public"

# JWT
JWT_SECRET="your-secret-key-here"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-refresh-secret-here"
JWT_REFRESH_EXPIRES_IN="7d"

# Telegram Bot
BOT_TOKEN="your_telegram_bot_token_from_botfather"
OWNER_TELEGRAM_ID="your_telegram_user_id"

# Public URL of this backend (needed for Telegram webhooks, optional for polling/test-messages).
# Example: https://api.example.com
APP_PUBLIC_URL="http://localhost:3000"

# Домен веб-приложения (тот же WEB_DOMAIN, что в корневом .env / docker-compose).
# В письме сброса пароля: {https|http}://{WEB_DOMAIN}/reset-password?token=...
# Прод: orchestra.example.com
# Локально (Vite): localhost:5173
WEB_DOMAIN=localhost:5173

# TTL токена сброса в минутах (по умолчанию 30)
# PASSWORD_RESET_TTL_MIN=30
# Только отладка: вернуть токен в теле ответа forgot-password даже в production
# PASSWORD_RESET_RETURN_TOKEN=false

# SMTP Яндекс (письма «сброс пароля»)
# 1) id.yandex.ru → Безопасность → Пароли приложений → создать пароль для «Почта»
# 2) SMTP_USER = полный email (name@yandex.ru / name@yandex.com)
# 3) SMTP_PASS = пароль приложения (не обычный пароль от аккаунта)
# 4) MAIL_FROM должен совпадать с этим ящиком
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Orchestra <name@yandex.ru>"

# Encryption key for storing user-provided Telegram bot tokens (32 bytes, base64).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BOT_TOKENS_KEY="change-me"

# Bot <-> Backend интеграция
# Секрет для доступа к /bot/* эндпоинтам в backend (передаётся в заголовке Authorization: Bearer ... или X-Bot-Secret)
BOT_SECRET="change-me"

# Внутренний URL bot-сервиса (который умеет публиковать репетиции в чат)
BOT_INTERNAL_URL="http://bot:3001"

# Единственный внутренний секрет для server-to-server:
# - back -> bot runner (/internal/publish-*)
# - bot runner -> back (/internal/telegram-bots/*)
INTERNAL_API_SECRET="change-me-internal"

# S3 / MinIO (optional, for file uploads)
# NOTE: в коде используются переменные с префиксом S3_* (а не AWS_*).
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=orchestra
S3_SECRET_KEY=orchestra_secret
S3_BUCKET=orchestra-media

# Theater kit: node ../scripts/push-theater-assets-to-minio.cjs → keys theater/*
# Фронт: VITE_THEATER_ASSETS_BASE_URL={S3_PUBLIC_URL}/{S3_BUCKET}

# Legacy (не используется напрямую, оставлено чтобы не ломать старые .env)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
