FROM node:22-alpine AS development

WORKDIR /app

# Установка зависимостей
COPY package.json package-lock.json* ./
RUN npm install --legacy-peer-deps

COPY tsconfig.json tsconfig.build.json nest-cli.json ./

# Prisma 7: URL в prisma.config.ts (как в Dockerfile)
COPY prisma ./prisma
COPY prisma.config.ts ./

# prisma.config.ts вызывает env("DATABASE_URL"); на build connect не нужен — подставляем валидную заглушку
ENV DATABASE_URL="postgresql://orkestr:orkestr_secret@127.0.0.1:5432/dophamin_orkestr"
RUN npx prisma generate

# Expose ports
EXPOSE 3000 9229

# Dev runner: polling для TypeScript + перезапуск после изменений Prisma.
CMD ["npm", "run", "start:dev"]
