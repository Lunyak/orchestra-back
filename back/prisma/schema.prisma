generator client {
  // Prisma 7 + Node.js, клиент живёт в @prisma/client
  provider = "prisma-client-js"
}

datasource db {
  // сама строка подключения задаётся в prisma.config.ts через env('DATABASE_URL')
  provider = "postgresql"
}

model User {
  id               String             @id @default(cuid())
  email            String             @unique
  passwordHash     String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  subscriptionId   String?
  subscription     SubscriptionPlan?  @relation(fields: [subscriptionId], references: [id])

  projectsOwned      Project[]        @relation("ProjectOwner")
  projectMemberships ProjectMember[]
  actorNotes         ActorNote[]
  actorAnnotations   ActorAnnotation[]
  telegramBots       TelegramBotIntegration[]
  projectTelegramBotPreferences ProjectTelegramBotPreference[]
  directorSessions   DirectorSession[]
  roleNotes          ProjectRoleNote[]
  rehearsalComments  RehearsalComment[]
  directorSessionComments DirectorSessionComment[]
  troupeMemberships  TroupeMember[]
  troupeOwned        Troupe?
  passwordResetTokens PasswordResetToken[]
  chatMessages       ChatMessage[]
  chatReadStates     ChatConversationReadState[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  /// SHA-256(token) в base64url
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserProfile {
  /// Профиль по email.
  /// ВАЖНО: не привязываем FK к User, чтобы бот мог заливать профили
  /// даже для тех, кто ещё не зарегистрирован в сервисе.
  email            String   @id
  displayName      String?
  firstName        String?
  lastName         String?
  telegramUsername String?
  telegramId       String?  @unique
  avatarUrl        String?
  availabilityCalendar Json?
  /// Доступность по времени на конкретные даты:
  /// { "YYYY-MM-DD": [ { from: "HH:mm", to: "HH:mm" }, ... ] }
  availabilityTimeRanges Json?
  sex              String?
  /// Роль в театре (актер, режиссер, и т.д.)
  role             String?
  phone            String?
  birthday         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SubscriptionPlan {
  id                         String   @id @default(cuid())
  name                       String   @unique
  maxProjects                Int?
  maxCollaboratorsPerProject Int?
  features                   Json

  users                      User[]
}

model Project {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?
  ownerId     String
  owner       User            @relation("ProjectOwner", fields: [ownerId], references: [id])

  scenes      Scene[]
  members     ProjectMember[]
  telegramBotPreferences ProjectTelegramBotPreference[]
  modelFiles  ProjectModelFile[]
  rehearsals  Rehearsal[]
  actorNotes       ActorNote[]
  actorAnnotations ActorAnnotation[]
  directorSessions DirectorSession[]
  roles            ProjectRole[]

  @@index([ownerId])
}

enum RehearsalParticipantStatus {
  unknown
  present
  absent
  late
}

model Rehearsal {
  id            String   @id @default(cuid())
  projectId     String
  title         String
  startsAt      DateTime
  durationMin   Int?
  notes         String?
  place         String?  // Место проведения репетиции
  /// Выбранные сцены на эту репетицию (массив id сцен). Если null/пусто — значит "не выбрано".
  selectedSceneIds Json?
  /// Выбранные "сцены" (шаги) на эту репетицию: [{ sceneId, stepId }]
  selectedSteps Json?
  telegramChatId       String?  // ID группы в Telegram
  telegramMessageId    String?  // ID сообщения опроса в Telegram
  telegramThreadId     String?  // ID топика в группе
  publishedAt   DateTime? // Когда репетиция была опубликована в чат
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String?
  createdVia    String?  // "web" | "bot" и т.п.

  project       Project  @relation(fields: [projectId], references: [id])
  participants  RehearsalParticipant[]
  comments      RehearsalComment[]

  @@index([projectId, startsAt])
}

model RehearsalComment {
  id            String   @id @default(cuid())
  rehearsalId   String
  authorUserId  String
  authorEmail   String
  content       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rehearsal     Rehearsal @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  authorUser    User      @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@unique([rehearsalId, authorUserId])
  @@index([rehearsalId])
  @@index([authorUserId])
  @@index([authorEmail])
}

model RehearsalParticipant {
  id           String                     @id @default(cuid())
  rehearsalId  String
  email        String
  telegramId   String?
  userName     String?  // Имя пользователя для отображения
  status       RehearsalParticipantStatus @default(unknown)
  roles        Json?
  lateTime     String?  // Время когда придет (для опаздывающих)
  respondedAt  DateTime? // Когда участник последний раз отметился по этой репетиции
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  rehearsal    Rehearsal                  @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)

  @@unique([rehearsalId, email])
  @@index([email])
  @@index([telegramId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String

  project   Project  @relation(fields: [projectId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
}

/// Per-user per-project preference: which connected Telegram bot to use for publishing.
model ProjectTelegramBotPreference {
  id               String               @id @default(cuid())
  projectId        String
  userId           String
  botIntegrationId String

  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  bot              TelegramBotIntegration @relation(fields: [botIntegrationId], references: [id], onDelete: Cascade)

  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
  @@index([botIntegrationId])
}

model Scene {
  id        String   @id @default(cuid())
  projectId String
  name      String
  /// Метаданные сцены (в т.ч. привязки ролей к шагам: sceneRoles v1)
  sceneRoles Json?
  /// Настройка пульта света: фейдеры, количество фейдеров и привязки
  lightFaders Json?
  /// Программы света: сохранённые состояния фейдеров
  lightPrograms Json?
  /// Какие K отмечены для записи в техкарту (toggles над схемой)
  lightChannelRoles Json?
  /// Видео проектора и заставка (v1: videos + projector)
  projectorMedia Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  project   Project  @relation(fields: [projectId], references: [id])

  playlist       PlaylistItem[]
  sounds         Sound[]
  steps          Step[]
  lightChannels  GlobalLightChannel[]
  lightPlot      GlobalLightPlot[]
  theaterLayout  TheaterLayout?
  actorNotes     ActorNote[]
  actorAnnotations ActorAnnotation[]
}

model DirectorSession {
  id        String   @id
  projectId String
  userId    String
  /// Порядок в списке (кастомный порядок пользователя, не зависит от startsAt)
  order     Int      @default(0)
  title     String
  startsAt  DateTime
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments  DirectorSessionComment[]

  @@index([projectId])
  @@index([userId])
  @@index([projectId, startsAt])
}

model DirectorSessionComment {
  id            String   @id @default(cuid())
  sessionId     String
  authorUserId  String
  authorEmail   String
  content       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  session       DirectorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  authorUser    User            @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@unique([sessionId, authorUserId])
  @@index([sessionId])
  @@index([authorUserId])
  @@index([authorEmail])
}

model ProjectRole {
  id          String   @id @default(cuid())
  projectId   String
  /// Нормализованный ключ роли (lowercase, без спецсимволов). Уникален в рамках проекта.
  key         String
  /// Отображаемое имя роли.
  title       String
  description String?
  /// Ключ изображения в хранилище проекта (projectId/image/...).
  avatarKey   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  aliases     ProjectRoleAlias[]
  assignments ProjectRoleAssignment[]
  notes       ProjectRoleNote[]

  @@unique([projectId, key])
  @@index([projectId])
}

model ProjectRoleAlias {
  id      String @id @default(cuid())
  roleId  String
  /// Нормализованный ключ алиаса
  key     String
  /// Оригинальная строка алиаса
  title   String

  role    ProjectRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, key])
  @@index([key])
}

model ProjectRoleAssignment {
  id        String   @id @default(cuid())
  roleId    String
  /// Email актёра (lower-case). Привязка к UserProfile по email.
  email     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role      ProjectRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, email])
  @@index([email])
}

model ProjectRoleNote {
  id          String   @id @default(cuid())
  roleId      String
  /// Кто написал (userId если автор залогинен), иначе null.
  authorUserId String?
  authorEmail  String?
  content      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role        ProjectRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  authorUser  User?       @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([roleId])
  @@index([authorUserId])
}

model PlaylistItem {
  id        String @id @default(cuid())
  sceneId   String
  order     Int
  sourceId  Int
  title     String
  file      String
  remoteUrl String?
  remoteKey String?
  fadeMs    Int
  loop      Boolean

  scene     Scene  @relation(fields: [sceneId], references: [id])
}

model Sound {
  id        String @id @default(cuid())
  sceneId   String
  sourceId  Int
  title     String
  file      String
  icon      String?
  remoteUrl String?
  remoteKey String?
  iconRemoteUrl String?
  iconRemoteKey String?
  volume    Float
  fadeMs    Int
  loop      Boolean

  scene     Scene  @relation(fields: [sceneId], references: [id])
}

model Step {
  id           String   @id @default(cuid())
  sceneId      String
  sourceId     Int
  title        String
  markdown     String?
  playMarkdown String?
  explicationMarkdown String?
  durationMin  Int?
  kanbanStatus String?
  kanbanOrder  Int?
  cast         Json?
  /// Снимки картин света (фейдеры по K+F), синхронизируются с markdown
  lightKadrs   Json?
  order        Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  scene        Scene    @relation(fields: [sceneId], references: [id])

  requisites        StepRequisite[]
  lightPlot         StepLightPlot[]
  theaterModels     TheaterModel[]
  theaterSpotlights TheaterSpotlight[]
}

model StepRequisite {
  id       String @id @default(cuid())
  stepId   String
  sourceId Int
  label    String
  checked  Boolean @default(false)

  step     Step   @relation(fields: [stepId], references: [id])
}

model StepLightPlot {
  id       String @id @default(cuid())
  stepId   String
  sourceId Int
  label    String
  channel  String?
  x        Int
  y        Int
  angle    Int
  length   Int

  step     Step   @relation(fields: [stepId], references: [id])
}

model TheaterModel {
  id              String   @id @default(cuid())
  stepId          String
  sourceId        Int
  name            String
  type            String
  builtin         String?
  file            String?
  kind            String   @default("prop")
  allowOutOfBounds Boolean @default(false)
  position        Json
  rotation        Json
  scale           Json
  decorSize         Json?
  decorColor        String?
  decorTexture      String?
  decorTextureRepeat Float?
  decorTextureMode   String?
  decorTextureFaces  Json?

  step            Step    @relation(fields: [stepId], references: [id])
}

model TheaterSpotlight {
  id        String  @id @default(cuid())
  stepId    String
  sourceId  Int
  label     String
  position  Json
  target    Json
  angleDeg  Int
  intensity Float
  color     String
  enabled   Boolean
  channel   Int
  isRgb     Boolean
  /// Номер фейдера пульта, к которому привязан софит.
  faderId   Int?
  hidden    Boolean @default(false)
  gridCol   Int?
  gridRow   Int?

  step      Step    @relation(fields: [stepId], references: [id])
}

model GlobalLightChannel {
  id      String  @id @default(cuid())
  sceneId String
  raw     String
  index   Int

  scene   Scene   @relation(fields: [sceneId], references: [id])
}

model GlobalLightPlot {
  id       String @id @default(cuid())
  sceneId  String
  sourceId Int
  label    String
  channel  String
  x        Int
  y        Int
  angle    Int
  length   Int

  scene    Scene  @relation(fields: [sceneId], references: [id])
}

model TheaterLayout {
  id             String @id @default(cuid())
  sceneId        String @unique
  hallWidth      Float
  hallDepth      Float
  wallHeight     Float
  stageWidth     Float
  stageDepth     Float
  stageHeight    Float
  stageZ         Float
  audienceStartZ Float
  seatRows       Int
  seatsPerRow    Int
  seatSpacing    Float
  rowSpacing     Float
  aisleWidth     Float
  aisleCenterX   Float
  doorWidth      Float
  doorHeight     Float
  doorZ          Float
  rowRise        Float
  doors          Json?
  extras         Json?

  scene          Scene  @relation(fields: [sceneId], references: [id])
}

model ProjectModelFile {
  id         String  @id @default(cuid())
  projectId  String
  fileName   String
  path       String
  uploadedAt DateTime @default(now())

  project    Project @relation(fields: [projectId], references: [id])
}

model BotSettings {
  id                String   @id @default("singleton")
  groupChatId       String?  // ID группы Telegram для опросов
  attendanceThreadId String? // ID топика для опросов о явке
  announcementsThreadId String? // ID топика для объявлений
  projectSlug       String?  // Slug проекта по умолчанию для бота
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model TelegramBotIntegration {
  id                    String   @id @default(cuid())
  ownerUserId           String
  owner                 User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  /// Шифрованный токен Telegram бота (никогда не отдаём на frontend).
  tokenEncrypted        String

  /// getMe.username
  botUsername           String?
  /// getMe.id
  botTelegramUserId     String?

  /// Telegram ID владельца (аналог OWNER_TELEGRAM_ID из env, но пер-бот)
  ownerTelegramId       String?
  /// Telegram ID администратора (аналог ADMIN_ID из env, но пер-бот)
  adminTelegramId       String?

  /// Произвольное имя для отображения в UI
  title                 String?

  /// connected | disabled | error
  status                String   @default("connected")

  /// Секрет для валидации webhook запросов (header X-Telegram-Bot-Api-Secret-Token)
  webhookSecret         String

  // Настройки публикации/проекта — пер-бот
  groupChatId           String?
  attendanceThreadId    String?
  announcementsThreadId String?
  defaultProjectSlug    String?

  /// Квиз/игры (аналог QUIZ_GROUP_CHAT_ID / QUIZ_THREAD_ID из env, но пер-бот)
  quizGroupChatId       String?
  quizThreadId          String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  variables             BotVariable[]
  projectPreferences    ProjectTelegramBotPreference[]

  @@index([ownerUserId])
  @@unique([botTelegramUserId])
}

model BotVariable {
  id        String  @id @default(cuid())
  botId     String
  bot       TelegramBotIntegration @relation(fields: [botId], references: [id], onDelete: Cascade)

  key       String
  value     String
  isSecret  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([botId, key])
  @@index([botId])
}

model ActorNote {
  id           String   @id @default(cuid())
  userId       String
  projectId    String
  sceneId      String?
  stepSourceId Int?
  text         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scene   Scene?  @relation(fields: [sceneId], references: [id], onDelete: SetNull)

  @@unique([userId, sceneId, stepSourceId])
  @@index([projectId])
  @@index([userId])
  @@index([sceneId])
}

enum ActorAnnotationField {
  markdown
  playMarkdown
  explicationMarkdown
}

model ActorAnnotation {
  id           String               @id @default(cuid())
  userId       String
  projectId    String
  sceneId      String
  stepSourceId Int
  field        ActorAnnotationField
  startOffset  Int
  endOffset    Int
  selectedText String?
  noteText     String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scene   Scene   @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@index([userId, sceneId, stepSourceId, field])
  @@index([projectId])
}

model Troupe {
  id          String   @id @default(cuid())
  ownerUserId String   @unique
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  title       String   @default("Моя труппа")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members            TroupeMember[]
  chatConversations  ChatConversation[]
  premises           Premise[]

  @@index([ownerUserId])
}

enum PremiseKind {
  OWNED
  RENTED
}

enum PremiseMemberRole {
  owner
  manager
  tenant
  viewer
}

enum PremiseSlotStatus {
  confirmed
  pending
  cancelled
}

/// Физическое помещение труппы (своё или снимаемое).
model Premise {
  id        String      @id @default(cuid())
  troupeId  String
  name      String
  kind      PremiseKind @default(OWNED)
  address   String?
  capacity  Int?
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  troupe  Troupe          @relation(fields: [troupeId], references: [id], onDelete: Cascade)
  members PremiseMember[]
  slots   PremiseSlot[]

  @@index([troupeId])
}

/// Участник помещения (любой email, не обязательно из труппы).
model PremiseMember {
  id        String            @id @default(cuid())
  premiseId String
  email     String
  role      PremiseMemberRole @default(viewer)
  canBook   Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  premise Premise @relation(fields: [premiseId], references: [id], onDelete: Cascade)

  @@unique([premiseId, email])
  @@index([email])
  @@index([premiseId])
}

/// Слот занятости помещения.
model PremiseSlot {
  id             String            @id @default(cuid())
  premiseId      String
  startsAt       DateTime
  durationMin    Int
  title          String
  purpose        String?
  rentalNotes    String?
  contactEmail   String?
  contactName    String?
  status         PremiseSlotStatus @default(confirmed)
  createdByEmail String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  premise Premise @relation(fields: [premiseId], references: [id], onDelete: Cascade)

  @@index([premiseId, startsAt])
}

enum ChatConversationKind {
  TROUPE
}

/// Комната чата: тип + привязка к сущности (сейчас только труппа).
model ChatConversation {
  id        String               @id @default(cuid())
  kind      ChatConversationKind
  troupeId  String?
  title     String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  troupe   Troupe?       @relation(fields: [troupeId], references: [id], onDelete: Cascade)
  messages ChatMessage[]
  readStates ChatConversationReadState[]

  @@unique([troupeId, kind])
  @@index([troupeId])
}

/// До какого момента пользователь «дочитал» чат (для непрочитанных).
model ChatConversationReadState {
  id             String   @id @default(cuid())
  userId         String
  conversationId String
  lastReadAt     DateTime

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation ChatConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([userId])
  @@index([conversationId])
}

model ChatMessage {
  id              String   @id @default(cuid())
  conversationId String
  authorUserId    String
  body            String
  clientMessageId String?
  createdAt       DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User             @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@unique([conversationId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([authorUserId])
}

model TroupeMember {
  id        String   @id @default(cuid())
  troupeId  String
  troupe    Troupe   @relation(fields: [troupeId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Email участника труппы. Храним в lower-case.
  email     String
  createdAt DateTime @default(now())

  @@unique([troupeId, email])
  @@index([email])
  @@index([troupeId])
  @@index([userId])
}