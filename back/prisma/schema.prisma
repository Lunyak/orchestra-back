generator client {
  // Prisma 7 + Node.js, клиент живёт в @prisma/client
  provider = "prisma-client-js"
}

datasource db {
  // сама строка подключения задаётся в prisma.config.ts через env('DATABASE_URL')
  provider = "postgresql"
}

model User {
  id             String            @id @default(cuid())
  email          String            @unique
  passwordHash   String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  subscriptionId String?
  subscription   SubscriptionPlan? @relation(fields: [subscriptionId], references: [id])

  projectsOwned                 Project[]                      @relation("ProjectOwner")
  projectMemberships            ProjectMember[]
  actorNotes                    ActorNote[]
  actorAnnotations              ActorAnnotation[]
  telegramBots                  TelegramBotIntegration[]
  messengerChannels             MessengerChannel[]
  messengerBridges              MessengerBridge[]
  projectTelegramBotPreferences ProjectTelegramBotPreference[]
  directorSessions              DirectorSession[]
  roleNotes                     ProjectRoleNote[]
  rehearsalComments             RehearsalComment[]
  directorSessionComments       DirectorSessionComment[]
  projectTasksCreated           ProjectTask[]                  @relation("ProjectTaskCreator")
  troupeMemberships             TroupeMember[]
  teamMemberships               TeamMember[]                   @relation("TeamMemberUser")
  teamMembersOwned              TeamMember[]                   @relation("TeamOwner")
  troupesOwned                  Troupe[]
  passwordResetTokens           PasswordResetToken[]
  chatMessages                  ChatMessage[]
  chatReadStates                ChatConversationReadState[]
  studiosOwned                  Studio[]                       @relation("StudioOwner")
  studioMemberships             StudioMember[]
  studioInvitesCreated          StudioInvite[]                 @relation("StudioInviteCreator")
  projectInvitesCreated         ProjectInvite[]                @relation("ProjectInviteCreator")
  projectTheaterInvitesCreated  ProjectTheaterInvite[]         @relation("ProjectTheaterInviteCreator")
  troupeInvitesCreated          TroupeInvite[]                 @relation("TroupeInviteCreator")
  studioAssignmentsCreated      StudioAssignment[]             @relation("StudioAssignmentCreator")
  studioSubmissionsGraded       StudioSubmission[]             @relation("StudioSubmissionGrader")
  studioLessonProgressReviewed  StudioLessonProgress[]         @relation("StudioLessonProgressReviewer")
  personalWorkspace             Workspace?                     @relation("PersonalWorkspaceOwner")
  workspaceMemberships          WorkspaceMember[]
  billingPayments               BillingPayment[]
}

enum WorkspaceType {
  PERSONAL
  THEATER
  TROUPE
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

model Workspace {
  id              String        @id @default(cuid())
  type            WorkspaceType
  name            String
  personalOwnerId String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  personalOwner User?                @relation("PersonalWorkspaceOwner", fields: [personalOwnerId], references: [id], onDelete: Cascade)
  memberships   WorkspaceMember[]
  projects      Project[]
  theater       Theater?
  troupe        Troupe?
  rehearsals    RehearsalWorkspace[]

  @@index([type])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  /// SHA-256(token) в base64url
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserProfile {
  /// Профиль по email.
  /// ВАЖНО: не привязываем FK к User, чтобы бот мог заливать профили
  /// даже для тех, кто ещё не зарегистрирован в сервисе.
  email                  String   @id
  displayName            String?
  firstName              String?
  lastName               String?
  telegramUsername       String?
  telegramId             String?  @unique
  avatarUrl              String?
  /// Компактный аватар для списков / мини-чипов (опционально).
  avatarSmallUrl         String?
  availabilityCalendar   Json?
  /// Доступность по времени на конкретные даты:
  /// { "YYYY-MM-DD": [ { from: "HH:mm", to: "HH:mm" }, ... ] }
  availabilityTimeRanges Json?
  sex                    String?
  /// Роль в театре (актер, режиссер, и т.д.)
  role                   String?
  phone                  String?
  birthday               String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model SubscriptionPlan {
  id                         String @id @default(cuid())
  name                       String @unique
  maxProjects                Int?
  maxCollaboratorsPerProject Int?
  features                   Json

  users User[]
}

model BillingPayment {
  id               String   @id
  userId           String
  planName         String
  amountRub        Int
  status           String
  confirmationUrl  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Project {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  ownerId     String
  owner       User      @relation("ProjectOwner", fields: [ownerId], references: [id])
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  playbooks              Playbook[]
  members                ProjectMember[]
  invites                ProjectInvite[]
  theaterInvites         ProjectTheaterInvite[]
  telegramBotPreferences ProjectTelegramBotPreference[]
  modelFiles             ProjectModelFile[]
  rehearsals             Rehearsal[]
  rehearsalMaterials     RehearsalProject[]
  actorNotes             ActorNote[]
  actorAnnotations       ActorAnnotation[]
  directorSessions       DirectorSession[]
  roles                  ProjectRole[]
  teamRoles              ProjectTeamRole[]
  tasks                  ProjectTask[]
  theaters               ProjectTheater[]

  @@index([ownerId])
  @@index([workspaceId])
}

/// Приглашение в проект (token хранится как SHA-256).
model ProjectInvite {
  id              String    @id @default(cuid())
  projectId       String
  tokenHash       String    @unique
  role            String    @default("editor")
  /// Принять может только этот email.
  email           String
  createdByUserId String
  expiresAt       DateTime?
  acceptedAt      DateTime?
  declinedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("ProjectInviteCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([email])
}

/// Ссылка для партнёрской привязки проекта к театру (token = SHA-256).
model ProjectTheaterInvite {
  id                String    @id @default(cuid())
  projectId         String
  tokenHash         String    @unique
  createdByUserId   String
  expiresAt         DateTime?
  acceptedAt        DateTime?
  revokedAt         DateTime?
  acceptedTheaterId String?
  createdAt         DateTime  @default(now())

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy       User     @relation("ProjectTheaterInviteCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  acceptedTheater Theater? @relation(fields: [acceptedTheaterId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model ProjectTheater {
  id                String   @id @default(cuid())
  projectId         String
  theaterId         String
  participationType String   @default("PARTNER")
  createdAt         DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  theater Theater @relation(fields: [theaterId], references: [id], onDelete: Cascade)

  @@unique([projectId, theaterId])
  @@index([projectId])
  @@index([theaterId])
}

model Theater {
  id          String   @id @default(cuid())
  workspaceId String   @unique
  title       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace      Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  premises       Premise[]
  projects       ProjectTheater[]
  theaterInvites ProjectTheaterInvite[]
  troupes        TheaterTroupe[]
  homeTroupes    Troupe[]
}

model TheaterTroupe {
  id                String   @id @default(cuid())
  theaterId         String
  troupeId          String
  participationType String   @default("PARTNER")
  createdAt         DateTime @default(now())

  theater Theater @relation(fields: [theaterId], references: [id], onDelete: Cascade)
  troupe  Troupe  @relation(fields: [troupeId], references: [id], onDelete: Cascade)

  @@unique([theaterId, troupeId])
  @@index([theaterId])
  @@index([troupeId])
}

enum ProjectTaskStatus {
  todo
  in_progress
  done
  blocked
}

enum ProjectTaskCategory {
  props
  costume
  light
  sound
  admin
  production
  other
}

enum ProjectTaskSource {
  manual
  requisite
}

model ProjectTask {
  id             String              @id @default(cuid())
  projectId      String
  title          String
  description    String?
  status         ProjectTaskStatus   @default(todo)
  category       ProjectTaskCategory @default(other)
  source         ProjectTaskSource   @default(manual)
  /// Уникальный ключ для импорта (например requisite:12:3:setup:email)
  sourceKey      String?
  assigneeEmail  String?
  dueAt          DateTime?
  refSceneId     Int?
  refRequisiteId Int?
  refAction      String?
  sortOrder      Int                 @default(0)
  createdById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("ProjectTaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([projectId, sourceKey])
  @@index([projectId, status])
  @@index([projectId, sortOrder])
  @@index([assigneeEmail])
}

enum RehearsalParticipantStatus {
  unknown
  present
  absent
  late
}

model Rehearsal {
  id                  String    @id @default(cuid())
  projectId           String
  title               String
  startsAt            DateTime
  durationMin         Int?
  notes               String?
  place               String? // Место проведения репетиции
  /// Выбранные playbook-модули на репетицию (массив id). Если null/пусто — «не выбрано».
  selectedPlaybookIds Json?
  /// Выбранные сцены спектакля: [{ playbookId, sceneId }]
  selectedScenes      Json?
  telegramChatId      String? // ID группы в Telegram
  telegramMessageId   String? // ID сообщения опроса в Telegram
  telegramThreadId    String? // ID топика в группе
  publishedAt         DateTime? // Когда репетиция была опубликована в чат
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdBy           String?
  createdVia          String? // "web" | "bot" и т.п.

  project         Project                @relation(fields: [projectId], references: [id])
  participants    RehearsalParticipant[]
  comments        RehearsalComment[]
  workspaces      RehearsalWorkspace[]
  projects        RehearsalProject[]
  directorSession DirectorSession?

  @@index([projectId, startsAt])
}

model RehearsalProject {
  rehearsalId String
  projectId   String
  createdAt   DateTime @default(now())

  rehearsal Rehearsal @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([rehearsalId, projectId])
  @@index([projectId])
}

model RehearsalWorkspace {
  rehearsalId String
  workspaceId String
  createdAt   DateTime @default(now())

  rehearsal Rehearsal @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([rehearsalId, workspaceId])
  @@index([workspaceId])
}

model RehearsalComment {
  id           String   @id @default(cuid())
  rehearsalId  String
  authorUserId String
  authorEmail  String
  content      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rehearsal  Rehearsal @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  authorUser User      @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@unique([rehearsalId, authorUserId])
  @@index([rehearsalId])
  @@index([authorUserId])
  @@index([authorEmail])
}

model RehearsalParticipant {
  id          String                     @id @default(cuid())
  rehearsalId String
  email       String
  telegramId  String?
  userName    String? // Имя пользователя для отображения
  status      RehearsalParticipantStatus @default(unknown)
  roles       Json?
  lateTime    String? // Время когда придет (для опаздывающих)
  respondedAt DateTime? // Когда участник последний раз отметился по этой репетиции
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  rehearsal Rehearsal @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)

  @@unique([rehearsalId, email])
  @@index([email])
  @@index([telegramId])
}

model ProjectMember {
  id        String @id @default(cuid())
  projectId String
  userId    String
  role      String

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
}

/// Per-user per-project preference: which connected Telegram bot to use for publishing.
model ProjectTelegramBotPreference {
  id               String @id @default(cuid())
  projectId        String
  userId           String
  botIntegrationId String

  project Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bot     TelegramBotIntegration @relation(fields: [botIntegrationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
  @@index([botIntegrationId])
}

model Playbook {
  id                String    @id @default(cuid())
  projectId         String
  name              String
  /// Привязки ролей к сценам спектакля (sceneRoles v1)
  sceneRoles        Json?
  /// Настройка пульта света: фейдеры, количество фейдеров и привязки
  lightFaders       Json?
  /// Программы света: сохранённые состояния фейдеров
  lightPrograms     Json?
  /// Какие K отмечены для записи в картину (toggles над схемой)
  lightChannelRoles Json?
  /// Видео проектора и заставка (v1: videos + projector)
  projectorMedia    Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  project Project @relation(fields: [projectId], references: [id])

  playlist         PlaylistItem[]
  sounds           Sound[]
  scenes           Scene[]
  lightChannels    GlobalLightChannel[]
  lightPlot        GlobalLightPlot[]
  theaterLayout    TheaterLayout?
  actorNotes       ActorNote[]
  actorAnnotations ActorAnnotation[]
}

model DirectorSession {
  id        String   @id
  projectId String
  userId    String
  /// Порядок в списке (кастомный порядок пользователя, не зависит от startsAt)
  order     Int      @default(0)
  title     String
  startsAt  DateTime
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rehearsal Rehearsal                @relation(fields: [id], references: [id], onDelete: Cascade)
  comments  DirectorSessionComment[]

  @@index([projectId])
  @@index([userId])
  @@index([projectId, startsAt])
}

model DirectorSessionComment {
  id           String   @id @default(cuid())
  sessionId    String
  authorUserId String
  authorEmail  String
  content      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  session    DirectorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  authorUser User            @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@unique([sessionId, authorUserId])
  @@index([sessionId])
  @@index([authorUserId])
  @@index([authorEmail])
}

model ProjectRole {
  id          String   @id @default(cuid())
  projectId   String
  /// Нормализованный ключ роли (lowercase, без спецсимволов). Уникален в рамках проекта.
  key         String
  /// Отображаемое имя роли.
  title       String
  description String?
  /// Ключ изображения в хранилище проекта (projectId/image/...).
  avatarKey   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  aliases     ProjectRoleAlias[]
  assignments ProjectRoleAssignment[]
  notes       ProjectRoleNote[]

  @@unique([projectId, key])
  @@index([projectId])
}

model ProjectRoleAlias {
  id     String @id @default(cuid())
  roleId String
  /// Нормализованный ключ алиаса
  key    String
  /// Оригинальная строка алиаса
  title  String

  role ProjectRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, key])
  @@index([key])
}

model ProjectRoleAssignment {
  id        String   @id @default(cuid())
  roleId    String
  /// Email актёра (lower-case). Привязка к UserProfile по email.
  email     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role ProjectRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, email])
  @@index([email])
}

model ProjectRoleNote {
  id           String   @id @default(cuid())
  roleId       String
  /// Кто написал (userId если автор залогинен), иначе null.
  authorUserId String?
  authorEmail  String?
  content      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role       ProjectRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  authorUser User?       @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([roleId])
  @@index([authorUserId])
}

model PlaylistItem {
  id         String  @id @default(cuid())
  playbookId String
  order      Int
  sourceId   Int
  title      String
  file       String
  remoteUrl  String?
  remoteKey  String?
  fadeMs     Int
  loop       Boolean

  playbook Playbook @relation(fields: [playbookId], references: [id])
}

model Sound {
  id            String  @id @default(cuid())
  playbookId    String
  sourceId      Int
  title         String
  file          String
  icon          String?
  remoteUrl     String?
  remoteKey     String?
  iconRemoteUrl String?
  iconRemoteKey String?
  volume        Float
  fadeMs        Int
  loop          Boolean

  playbook Playbook @relation(fields: [playbookId], references: [id])
}

model Scene {
  id                  String    @id @default(cuid())
  playbookId          String
  sourceId            Int
  title               String
  markdown            String?
  playMarkdown        String?
  explicationMarkdown String?
  durationMin         Int?
  kanbanStatus        String?
  kanbanOrder         Int?
  cast                Json?
  /// Снимки картин света (фейдеры по K+F). Источник истины для прогона — JSON.
  lightKadrs          Json?
  order               Int
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  playbook Playbook @relation(fields: [playbookId], references: [id])

  requisites        SceneRequisite[]
  lightPlot         SceneLightPlot[]
  theaterModels     TheaterModel[]
  theaterSpotlights TheaterSpotlight[]
}

model SceneRequisite {
  id             String  @id @default(cuid())
  sceneId        String
  sourceId       Int
  label          String
  checked        Boolean @default(false)
  /// sourceId модели 3D-театра, если реквизит связан с ней
  theaterModelId Int?
  /// Ключ аватарки реквизита в project files
  avatarKey      String?
  /// Ответственный (email участника)
  assigneeEmail  String?
  /// Действие: setup | strike | use
  duty           String?
  /// Куда ставить (duty=setup)
  placeNote      String?
  /// Что сделать (duty=use)
  actionNote     String?

  scene Scene @relation(fields: [sceneId], references: [id])
}

model SceneLightPlot {
  id       String  @id @default(cuid())
  sceneId  String
  sourceId Int
  label    String
  channel  String?
  x        Int
  y        Int
  angle    Int
  length   Int

  scene Scene @relation(fields: [sceneId], references: [id])
}

model TheaterModel {
  id                 String  @id @default(cuid())
  sceneId            String
  sourceId           Int
  name               String
  type               String
  builtin            String?
  file               String?
  kind               String  @default("prop")
  allowOutOfBounds   Boolean @default(false)
  ignoreCollisions   Boolean @default(false)
  modelLowDetail     Boolean @default(false)
  isRequisite        Boolean @default(false)
  position           Json
  rotation           Json
  scale              Json
  decorSize          Json?
  decorColor         String?
  decorTexture       String?
  decorTextureRepeat Float?
  decorTextureMode   String?
  decorTextureFaces  Json?

  scene Scene @relation(fields: [sceneId], references: [id])
}

model TheaterSpotlight {
  id             String  @id @default(cuid())
  sceneId        String
  sourceId       Int
  label          String
  position       Json
  target         Json
  angleDeg       Int
  intensity      Float
  color          String
  enabled        Boolean
  channel        Int
  isRgb          Boolean
  modelLowDetail Boolean @default(false)
  mountModelId   Int?
  mountPointId   String?
  /// Номер фейдера пульта, к которому привязан софит.
  faderId        Int?
  hidden         Boolean @default(false)
  gridCol        Int?
  gridRow        Int?

  scene Scene @relation(fields: [sceneId], references: [id])
}

model GlobalLightChannel {
  id         String @id @default(cuid())
  playbookId String
  raw        String
  index      Int

  playbook Playbook @relation(fields: [playbookId], references: [id])
}

model GlobalLightPlot {
  id         String @id @default(cuid())
  playbookId String
  sourceId   Int
  label      String
  channel    String
  x          Int
  y          Int
  angle      Int
  length     Int

  playbook Playbook @relation(fields: [playbookId], references: [id])
}

model TheaterLayout {
  id             String @id @default(cuid())
  playbookId     String @unique
  hallWidth      Float
  hallDepth      Float
  wallHeight     Float
  stageWidth     Float
  stageDepth     Float
  stageHeight    Float
  stageZ         Float
  audienceStartZ Float
  seatRows       Int
  seatsPerRow    Int
  seatSpacing    Float
  rowSpacing     Float
  aisleWidth     Float
  aisleCenterX   Float
  doorWidth      Float
  doorHeight     Float
  doorZ          Float
  rowRise        Float
  doors          Json?
  extras         Json?

  playbook Playbook @relation(fields: [playbookId], references: [id])
}

model ProjectModelFile {
  id         String   @id @default(cuid())
  projectId  String
  fileName   String
  path       String
  uploadedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
}

model BotSettings {
  id                    String   @id @default("singleton")
  groupChatId           String? // ID группы Telegram для опросов
  attendanceThreadId    String? // ID топика для опросов о явке
  announcementsThreadId String? // ID топика для объявлений
  projectSlug           String? // Slug проекта по умолчанию для бота
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model TelegramBotIntegration {
  id          String @id @default(cuid())
  ownerUserId String
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  /// Шифрованный токен Telegram бота (никогда не отдаём на frontend).
  tokenEncrypted String

  /// getMe.username
  botUsername       String?
  /// getMe.id
  botTelegramUserId String?

  /// Telegram ID владельца (аналог OWNER_TELEGRAM_ID из env, но пер-бот)
  ownerTelegramId String?
  /// Telegram ID администратора (аналог ADMIN_ID из env, но пер-бот)
  adminTelegramId String?

  /// Произвольное имя для отображения в UI
  title String?

  /// connected | disabled | error
  status String @default("connected")

  /// Секрет для валидации webhook запросов (header X-Telegram-Bot-Api-Secret-Token)
  webhookSecret String

  // Настройки публикации/проекта — пер-бот
  groupChatId           String?
  attendanceThreadId    String?
  announcementsThreadId String?
  defaultProjectSlug    String?

  /// Квиз/игры (аналог QUIZ_GROUP_CHAT_ID / QUIZ_THREAD_ID из env, но пер-бот)
  quizGroupChatId String?
  quizThreadId    String?

  /// Как слать вызов в Telegram: on_publish | same_day | advance
  callNotifyMode String @default("on_publish")
  /// За сколько дней слать, если mode = advance (1–14)
  callNotifyAdvanceDays Int @default(1)
  /// Час Москвы, когда слать по расписанию (0–23)
  callNotifyHour Int @default(12)
  /// Личка тем, у кого не заполнена занятость на ближайший месяц
  availabilityRemindEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variables          BotVariable[]
  projectPreferences ProjectTelegramBotPreference[]

  @@unique([botTelegramUserId])
  @@index([ownerUserId])
}

model BotVariable {
  id    String                 @id @default(cuid())
  botId String
  bot   TelegramBotIntegration @relation(fields: [botId], references: [id], onDelete: Cascade)

  key      String
  value    String
  isSecret Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([botId, key])
  @@index([botId])
}

/// Max / VK (и др.) каналы. Telegram остаётся в TelegramBotIntegration.
model MessengerChannel {
  id          String @id @default(cuid())
  ownerUserId String
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  /// max | vk
  platform String

  title  String?
  /// connected | disabled | error
  status String @default("connected")

  tokenEncrypted String
  webhookSecret  String

  /// Max: bot user id; VK: group id
  externalBotId    String?
  externalUsername String?

  /// Чат/peer по умолчанию для публикаций и зеркала
  chatId String?

  /// VK: строка confirmation для Callback API
  vkConfirmation String?
  /// VK: numeric group id
  vkGroupId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bridgeMembers MessengerBridgeMember[]

  @@index([ownerUserId])
  @@index([platform])
  @@unique([platform, externalBotId])
}

/// Группа синхронизации: один primary → несколько mirror.
model MessengerBridge {
  id          String @id @default(cuid())
  ownerUserId String
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  title   String?
  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  MessengerBridgeMember[]
  mirrors  MirroredMessage[]

  @@index([ownerUserId])
}

model MessengerBridgeMember {
  id       String          @id @default(cuid())
  bridgeId String
  bridge   MessengerBridge @relation(fields: [bridgeId], references: [id], onDelete: Cascade)

  /// primary | mirror
  role String
  /// telegram | max | vk
  platform String

  /// Для platform=telegram
  telegramBotId String?
  /// Для platform=max|vk
  channelId String?
  channel   MessengerChannel? @relation(fields: [channelId], references: [id], onDelete: Cascade)

  /// Переопределение чата назначения (иначе chatId канала / groupChatId бота)
  chatId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bridgeId])
  @@index([telegramBotId])
  @@index([channelId])
}

model MirroredMessage {
  id       String          @id @default(cuid())
  bridgeId String
  bridge   MessengerBridge @relation(fields: [bridgeId], references: [id], onDelete: Cascade)

  sourcePlatform  String
  sourceMessageId String
  sourceRef       String

  targetPlatform  String
  targetMessageId String
  targetRef       String

  createdAt DateTime @default(now())

  @@unique([bridgeId, sourcePlatform, sourceMessageId, targetRef])
  @@index([bridgeId])
  @@index([sourcePlatform, sourceMessageId])
}

model ActorNote {
  id            String   @id @default(cuid())
  userId        String
  projectId     String
  playbookId    String?
  sceneSourceId Int?
  text          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  playbook Playbook? @relation(fields: [playbookId], references: [id], onDelete: SetNull)

  @@unique([userId, playbookId, sceneSourceId])
  @@index([projectId])
  @@index([userId])
  @@index([playbookId])
}

enum ActorAnnotationField {
  markdown
  playMarkdown
  explicationMarkdown
}

model ActorAnnotation {
  id            String               @id @default(cuid())
  userId        String
  projectId     String
  playbookId    String
  sceneSourceId Int
  field         ActorAnnotationField
  startOffset   Int
  endOffset     Int
  selectedText  String?
  noteText      String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  playbook Playbook @relation(fields: [playbookId], references: [id], onDelete: Cascade)

  @@index([userId, playbookId, sceneSourceId, field])
  @@index([projectId])
}

model Troupe {
  id          String    @id @default(cuid())
  ownerUserId String
  owner       User      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  /// Необязательный домашний театр. Независимая труппа может существовать без него.
  theaterId   String?
  theater     Theater?  @relation(fields: [theaterId], references: [id], onDelete: SetNull)
  title       String    @default("Моя труппа")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  members           TroupeMember[]
  invites           TroupeInvite[]
  roleDefinitions   TeamRoleDefinition[]
  chatConversations ChatConversation[]
  premises          Premise[]
  collections       TroupeCollection[]
  theaters          TheaterTroupe[]

  @@index([ownerUserId])
  @@index([theaterId])
}

/// Приглашение в труппу (token хранится как SHA-256).
model TroupeInvite {
  id              String           @id @default(cuid())
  troupeId        String
  tokenHash       String           @unique
  kind            TroupeMemberKind @default(regular)
  /// Принять может только этот email.
  email           String
  createdByUserId String
  expiresAt       DateTime?
  acceptedAt      DateTime?
  declinedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime         @default(now())

  troupe    Troupe @relation(fields: [troupeId], references: [id], onDelete: Cascade)
  createdBy User   @relation("TroupeInviteCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([troupeId])
  @@index([email])
}

enum TroupeCollectionStatus {
  draft
  active
  closed
}

/// Сбор средств труппы (аренда, членский взнос и т.п.).
model TroupeCollection {
  id             String                 @id @default(cuid())
  troupeId       String
  title          String
  description    String?
  status         TroupeCollectionStatus @default(active)
  dueAt          DateTime?
  premiseId      String?
  createdByEmail String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  troupe        Troupe                        @relation(fields: [troupeId], references: [id], onDelete: Cascade)
  premise       Premise?                      @relation(fields: [premiseId], references: [id], onDelete: SetNull)
  tariffs       TroupeCollectionTariff[]
  participants  TroupeCollectionParticipant[]
  contributions TroupeContribution[]

  @@index([troupeId])
  @@index([premiseId])
}

/// Тариф взноса внутри сбора (например «полный» / «льготный»).
model TroupeCollectionTariff {
  id            String   @id @default(cuid())
  collectionId  String
  title         String
  /// Сумма в копейках (₽ × 100).
  amountKopecks Int
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  collection   TroupeCollection              @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  participants TroupeCollectionParticipant[]

  @@index([collectionId])
}

/// Участник сбора с назначенным тарифом.
model TroupeCollectionParticipant {
  id           String   @id @default(cuid())
  collectionId String
  email        String
  tariffId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  collection TroupeCollection       @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  tariff     TroupeCollectionTariff @relation(fields: [tariffId], references: [id], onDelete: Restrict)

  @@unique([collectionId, email])
  @@index([collectionId])
  @@index([email])
}

/// Зафиксированный взнос участника.
model TroupeContribution {
  id              String   @id @default(cuid())
  collectionId    String
  email           String
  amountKopecks   Int
  paidAt          DateTime @default(now())
  recordedByEmail String
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  collection TroupeCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId, email])
}

enum PremiseKind {
  OWNED
  RENTED
}

enum PremiseMemberRole {
  owner
  manager
  tenant
  viewer
}

enum PremiseBookedAsKind {
  user
  troupe
  theater
  studio
  external
}

enum PremiseSlotStatus {
  confirmed
  pending
  cancelled
}

enum PremiseSlotPaymentStatus {
  unpaid
  paid
  waived
}

enum PremiseUsageType {
  internal
  friendly
  commercial
}

enum PremiseRecurrenceType {
  once
  weekly
}

enum PremiseRentalStatus {
  pending
  active
  cancelled
  completed
}

enum PremiseAgreementStatus {
  draft
  awaiting_signature
  active
  terminated
  expired
}

enum PremiseAgreementDocumentKind {
  generated
  uploaded
  signed
}

enum PremiseRentalPaymentStatus {
  unpaid
  paid
  waived
}

/// Физическое помещение труппы (своё или снимаемое).
model Premise {
  id        String      @id @default(cuid())
  troupeId  String?
  theaterId String?
  studioId  String?
  name      String
  kind      PremiseKind @default(OWNED)
  address   String?
  capacity  Int?
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  troupe       Troupe?               @relation(fields: [troupeId], references: [id], onDelete: Cascade)
  theater      Theater?              @relation(fields: [theaterId], references: [id], onDelete: Cascade)
  studio       Studio?               @relation(fields: [studioId], references: [id], onDelete: Cascade)
  members      PremiseMember[]
  slots        PremiseSlot[]
  rentals      PremiseRental[]
  availability PremiseAvailability[]
  collections  TroupeCollection[]

  @@index([troupeId])
  @@index([theaterId])
  @@index([studioId])
}

model PremiseRental {
  id                   String                @id @default(cuid())
  premiseId            String
  usageType            PremiseUsageType
  recurrenceType       PremiseRecurrenceType
  title                String
  purpose              String?
  rentalNotes          String?
  contactEmail         String?
  contactName          String?
  contactPhone         String?
  bookedAsKind         PremiseBookedAsKind   @default(user)
  bookedAsId           String?
  bookedAsTitle        String                @default("")
  startsOn             DateTime
  endsOn               DateTime?
  timezoneOffsetMin    Int                   @default(0)
  monthlyAmountKopecks Int?
  paymentDueDay        Int?
  agreementRequested   Boolean               @default(false)
  status               PremiseRentalStatus   @default(pending)
  createdByEmail       String
  confirmedByEmail     String?
  confirmedAt          DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  premise   Premise                 @relation(fields: [premiseId], references: [id], onDelete: Cascade)
  schedules PremiseRentalSchedule[]
  slots     PremiseSlot[]
  agreement PremiseRentalAgreement?
  payments  PremiseRentalPayment[]

  @@index([premiseId, startsOn])
  @@index([status])
  @@index([bookedAsKind, bookedAsId])
}

model PremiseRentalSchedule {
  id          String @id @default(cuid())
  rentalId    String
  weekday     Int
  startsAtMin Int
  durationMin Int

  rental PremiseRental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  @@unique([rentalId, weekday])
  @@index([rentalId])
}

model PremiseRentalAgreement {
  id              String                 @id @default(cuid())
  rentalId        String                 @unique
  number          String
  status          PremiseAgreementStatus @default(draft)
  landlordName    String
  landlordDetails String?
  tenantName      String
  tenantDetails   String?
  termsSnapshot   Json
  signedAt        DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  rental    PremiseRental                    @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  documents PremiseRentalAgreementDocument[]

  @@index([status])
}

model PremiseRentalAgreementDocument {
  id          String                       @id @default(cuid())
  agreementId String
  kind        PremiseAgreementDocumentKind
  fileName    String
  storageKey  String
  mimeType    String
  sizeBytes   Int
  createdAt   DateTime                     @default(now())

  agreement PremiseRentalAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@index([agreementId, kind])
}

model PremiseRentalPayment {
  id            String                     @id @default(cuid())
  rentalId      String
  periodStart   DateTime
  dueAt         DateTime
  amountKopecks Int
  status        PremiseRentalPaymentStatus @default(unpaid)
  paidAt        DateTime?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  rental PremiseRental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  @@unique([rentalId, periodStart])
  @@index([rentalId, dueAt])
}

model PremiseAvailability {
  id          String @id @default(cuid())
  premiseId   String
  weekday     Int
  startsAtMin Int
  endsAtMin   Int

  premise Premise @relation(fields: [premiseId], references: [id], onDelete: Cascade)

  @@unique([premiseId, weekday])
  @@index([premiseId])
}

/// Участник помещения (любой email, не обязательно из труппы).
model PremiseMember {
  id        String            @id @default(cuid())
  premiseId String
  email     String
  role      PremiseMemberRole @default(viewer)
  canBook   Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  premise Premise @relation(fields: [premiseId], references: [id], onDelete: Cascade)

  @@unique([premiseId, email])
  @@index([email])
  @@index([premiseId])
}

/// Слот занятости помещения.
model PremiseSlot {
  id                  String                   @id @default(cuid())
  premiseId           String
  rentalId            String?
  startsAt            DateTime
  durationMin         Int
  title               String
  purpose             String?
  rentalNotes         String?
  rentalAmountKopecks Int?
  paymentStatus       PremiseSlotPaymentStatus @default(unpaid)
  contactEmail        String?
  contactName         String?
  contactPhone        String?
  status              PremiseSlotStatus        @default(confirmed)
  createdByEmail      String
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  premise Premise        @relation(fields: [premiseId], references: [id], onDelete: Cascade)
  rental  PremiseRental? @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  @@index([premiseId, startsAt])
  @@index([rentalId])
}

enum ChatConversationKind {
  TROUPE
}

/// Комната чата: тип + привязка к сущности (сейчас только труппа).
model ChatConversation {
  id        String               @id @default(cuid())
  kind      ChatConversationKind
  troupeId  String?
  title     String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  troupe     Troupe?                     @relation(fields: [troupeId], references: [id], onDelete: Cascade)
  messages   ChatMessage[]
  readStates ChatConversationReadState[]

  @@unique([troupeId, kind])
  @@index([troupeId])
}

/// До какого момента пользователь «дочитал» чат (для непрочитанных).
model ChatConversationReadState {
  id             String   @id @default(cuid())
  userId         String
  conversationId String
  lastReadAt     DateTime

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([userId])
  @@index([conversationId])
}

model ChatMessage {
  id              String   @id @default(cuid())
  conversationId  String
  authorUserId    String
  body            String
  clientMessageId String?
  createdAt       DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User             @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@unique([conversationId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([authorUserId])
}

model TroupeMember {
  id        String           @id @default(cuid())
  troupeId  String
  troupe    Troupe           @relation(fields: [troupeId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Email участника труппы. Храним в lower-case.
  email     String
  kind      TroupeMemberKind @default(regular)
  createdAt DateTime         @default(now())

  @@unique([troupeId, email])
  @@index([email])
  @@index([troupeId])
  @@index([userId])
}

enum TroupeMemberKind {
  regular
  guest
}

model TeamMember {
  id          String   @id @default(cuid())
  ownerUserId String
  owner       User     @relation("TeamOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation("TeamMemberUser", fields: [userId], references: [id], onDelete: SetNull)
  /// Email участника команды. Храним в lower-case.
  email       String
  /// Должности/функции в команде: actor, director, accountant, artist, producer, smm, assistant_director, troupe_manager.
  roles       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roleAssignments TeamRoleAssignment[]

  @@unique([ownerUserId, email])
  @@index([email])
  @@index([ownerUserId])
  @@index([userId])
}

/// Должность команды постановки (только проект; не штат театра).
model ProjectTeamRole {
  id          String            @id @default(cuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  slug        String
  title       String
  parentId    String?
  parent      ProjectTeamRole?  @relation("ProjectTeamRoleTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    ProjectTeamRole[] @relation("ProjectTeamRoleTree")
  sortOrder   Int               @default(0)
  description String            @default("")
  /// Ключ изображения в хранилище проекта (projectId/image/...).
  avatarKey   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  assignments ProjectTeamRoleAssignment[]

  @@unique([projectId, slug])
  @@index([projectId])
  @@index([parentId])
}

model ProjectTeamRoleAssignment {
  id        String          @id @default(cuid())
  roleId    String
  role      ProjectTeamRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  /// Email участника (lower-case).
  email     String
  createdAt DateTime        @default(now())

  @@unique([roleId, email])
  @@index([roleId])
  @@index([email])
}

model TeamRoleDefinition {
  id          String               @id @default(cuid())
  troupeId    String
  troupe      Troupe               @relation(fields: [troupeId], references: [id], onDelete: Cascade)
  slug        String
  title       String
  parentId    String?
  parent      TeamRoleDefinition?  @relation("TeamRoleTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    TeamRoleDefinition[] @relation("TeamRoleTree")
  sortOrder   Int                  @default(0)
  description String               @default("")
  /// Ключ изображения должности (если загружено в контексте проекта / файлового API).
  avatarKey   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  assignments TeamRoleAssignment[]

  @@unique([troupeId, slug])
  @@index([troupeId])
  @@index([parentId])
}

model TeamRoleAssignment {
  id           String             @id @default(cuid())
  roleId       String
  role         TeamRoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)
  teamMemberId String
  teamMember   TeamMember         @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now())

  @@unique([roleId, teamMemberId])
  @@index([roleId])
  @@index([teamMemberId])
}

enum StudioMemberRole {
  owner
  teacher
  student
}

/// Учебная студия (независима от труппы). Владелец может создать несколько.
model Studio {
  id          String   @id @default(cuid())
  ownerUserId String
  title       String
  description String?
  /// Логотип / обложка (URL после загрузки в files).
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User                  @relation("StudioOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  members     StudioMember[]
  invites     StudioInvite[]
  modules     StudioProgramModule[]
  assignments StudioAssignment[]
  videos      StudioVideo[]
  collections StudioCollection[]
  premises    Premise[]

  @@index([ownerUserId])
}

enum StudioCollectionStatus {
  draft
  active
  closed
}

/// Сбор средств студии (взносы, оплата курса и т.п.).
model StudioCollection {
  id             String                 @id @default(cuid())
  studioId       String
  title          String
  description    String?
  status         StudioCollectionStatus @default(active)
  dueAt          DateTime?
  createdByEmail String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  studio        Studio                        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  tariffs       StudioCollectionTariff[]
  participants  StudioCollectionParticipant[]
  contributions StudioContribution[]

  @@index([studioId])
}

model StudioCollectionTariff {
  id            String   @id @default(cuid())
  collectionId  String
  title         String
  /// Сумма в копейках (₽ × 100).
  amountKopecks Int
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  collection   StudioCollection              @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  participants StudioCollectionParticipant[]

  @@index([collectionId])
}

model StudioCollectionParticipant {
  id           String   @id @default(cuid())
  collectionId String
  email        String
  tariffId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  collection StudioCollection       @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  tariff     StudioCollectionTariff @relation(fields: [tariffId], references: [id], onDelete: Restrict)

  @@unique([collectionId, email])
  @@index([collectionId])
  @@index([email])
}

model StudioContribution {
  id              String   @id @default(cuid())
  collectionId    String
  email           String
  amountKopecks   Int
  paidAt          DateTime @default(now())
  recordedByEmail String
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  collection StudioCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId, email])
}

model StudioMember {
  id        String           @id @default(cuid())
  studioId  String
  email     String
  userId    String?
  role      StudioMemberRole @default(student)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([studioId, email])
  @@index([email])
  @@index([studioId])
  @@index([userId])
}

/// Ссылка-приглашение в студию (token хранится как SHA-256).
model StudioInvite {
  id              String           @id @default(cuid())
  studioId        String
  tokenHash       String           @unique
  role            StudioMemberRole @default(student)
  /// Если задан — принять может только этот email.
  email           String?
  createdByUserId String
  expiresAt       DateTime?
  acceptedAt      DateTime?
  declinedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime         @default(now())

  studio    Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  createdBy User   @relation("StudioInviteCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([email])
}

model StudioProgramModule {
  id          String   @id @default(cuid())
  studioId    String
  title       String
  description String?
  /// Обложка программы.
  imageUrl    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studio  Studio                @relation(fields: [studioId], references: [id], onDelete: Cascade)
  lessons StudioProgramLesson[]

  @@index([studioId, sortOrder])
}

enum StudioLessonTaskType {
  complete
  video
}

enum StudioLessonProgressStatus {
  pending
  submitted
  completed
  rejected
}

model StudioProgramLesson {
  id         String               @id @default(cuid())
  moduleId   String
  title      String
  body       String?
  /// Тип задания: отметить выполненным или сдать видео.
  taskType   StudioLessonTaskType @default(complete)
  /// Текст задания для студийца (дополнительно к body).
  taskPrompt String?
  sortOrder  Int                  @default(0)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  module      StudioProgramModule    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  assignments StudioAssignment[]
  progress    StudioLessonProgress[]

  @@index([moduleId, sortOrder])
}

/// Прогресс студийца по уроку.
model StudioLessonProgress {
  id               String                     @id @default(cuid())
  lessonId         String
  email            String
  status           StudioLessonProgressStatus @default(pending)
  videoUrl         String?
  note             String?
  submittedAt      DateTime?
  completedAt      DateTime?
  reviewedAt       DateTime?
  reviewedByUserId String?
  reviewComment    String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  lesson     StudioProgramLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  reviewedBy User?               @relation("StudioLessonProgressReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([lessonId, email])
  @@index([email])
  @@index([lessonId, status])
  @@index([reviewedByUserId])
}

model StudioAssignment {
  id              String    @id @default(cuid())
  studioId        String
  title           String
  description     String?
  createdByUserId String
  lessonId        String?
  dueAt           DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  studio      Studio                   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  createdBy   User                     @relation("StudioAssignmentCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  lesson      StudioProgramLesson?     @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  targets     StudioAssignmentTarget[]
  submissions StudioSubmission[]
  videos      StudioVideo[]

  @@index([studioId])
  @@index([createdByUserId])
  @@index([lessonId])
}

model StudioAssignmentTarget {
  id           String   @id @default(cuid())
  assignmentId String
  email        String
  createdAt    DateTime @default(now())

  assignment StudioAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, email])
  @@index([email])
}

model StudioSubmission {
  id             String    @id @default(cuid())
  assignmentId   String
  email          String
  body           String?
  videoUrl       String?
  submittedAt    DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  /// Оценка 1–5.
  grade          Int?
  gradeComment   String?
  gradedAt       DateTime?
  gradedByUserId String?

  assignment StudioAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  gradedBy   User?            @relation("StudioSubmissionGrader", fields: [gradedByUserId], references: [id], onDelete: SetNull)

  @@unique([assignmentId, email])
  @@index([email])
  @@index([gradedByUserId])
}

model StudioVideo {
  id              String   @id @default(cuid())
  studioId        String
  title           String
  url             String
  description     String?
  uploadedByEmail String
  assignmentId    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  studio     Studio              @relation(fields: [studioId], references: [id], onDelete: Cascade)
  assignment StudioAssignment?   @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  markers    StudioVideoMarker[]

  @@index([studioId])
  @@index([assignmentId])
  @@index([uploadedByEmail])
}

model StudioVideoMarker {
  id          String   @id @default(cuid())
  videoId     String
  /// Секунда от начала ролика.
  timeSec     Int
  body        String
  authorEmail String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  video StudioVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, timeSec])
  @@index([authorEmail])
}
