generator client {
  // Prisma 7 + Node.js, клиент живёт в @prisma/client
  provider = "prisma-client-js"
}

datasource db {
  // сама строка подключения задаётся в prisma.config.ts через env('DATABASE_URL')
  provider = "postgresql"
}

model User {
  id               String             @id @default(cuid())
  email            String             @unique
  passwordHash     String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  subscriptionId   String?
  subscription     SubscriptionPlan?  @relation(fields: [subscriptionId], references: [id])

  projectsOwned      Project[]        @relation("ProjectOwner")
  projectMemberships ProjectMember[]
}

model UserProfile {
  /// Профиль по email.
  /// ВАЖНО: не привязываем FK к User, чтобы бот мог заливать профили
  /// даже для тех, кто ещё не зарегистрирован в сервисе.
  email            String   @id
  displayName      String?
  firstName        String?
  lastName         String?
  telegramUsername String?
  telegramId       String?  @unique
  avatarUrl        String?
  availabilityCalendar Json?
  sex              String?
  /// Роль в театре (актер, режиссер, и т.д.)
  role             String?
  /// Роли/персонажи которые играет актер (JSON массив)
  characters       Json?
  phone            String?
  birthday         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SubscriptionPlan {
  id                         String   @id @default(cuid())
  name                       String   @unique
  maxProjects                Int?
  maxCollaboratorsPerProject Int?
  features                   Json

  users                      User[]
}

model Project {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?
  ownerId     String
  owner       User            @relation("ProjectOwner", fields: [ownerId], references: [id])

  scenes      Scene[]
  members     ProjectMember[]
  modelFiles  ProjectModelFile[]
  rehearsals  Rehearsal[]

  @@index([ownerId])
}

enum RehearsalParticipantStatus {
  unknown
  present
  absent
  late
}

model Rehearsal {
  id            String   @id @default(cuid())
  projectId     String
  title         String
  startsAt      DateTime
  durationMin   Int?
  notes         String?
  place         String?  // Место проведения репетиции
  /// Выбранные сцены на эту репетицию (массив id сцен). Если null/пусто — значит "не выбрано".
  selectedSceneIds Json?
  /// Выбранные "сцены" (шаги) на эту репетицию: [{ sceneId, stepId }]
  selectedSteps Json?
  telegramChatId       String?  // ID группы в Telegram
  telegramMessageId    String?  // ID сообщения опроса в Telegram
  telegramThreadId     String?  // ID топика в группе
  publishedAt   DateTime? // Когда репетиция была опубликована в чат
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String?
  createdVia    String?  // "web" | "bot" и т.п.

  project       Project  @relation(fields: [projectId], references: [id])
  participants  RehearsalParticipant[]

  @@index([projectId, startsAt])
}

model RehearsalParticipant {
  id           String                     @id @default(cuid())
  rehearsalId  String
  email        String
  telegramId   String?
  userName     String?  // Имя пользователя для отображения
  status       RehearsalParticipantStatus @default(unknown)
  roles        Json?
  lateTime     String?  // Время когда придет (для опаздывающих)
  respondedAt  DateTime? // Когда участник последний раз отметился по этой репетиции
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  rehearsal    Rehearsal                  @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)

  @@unique([rehearsalId, email])
  @@index([email])
  @@index([telegramId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String

  project   Project  @relation(fields: [projectId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
}

model Scene {
  id        String   @id @default(cuid())
  projectId String
  name      String
  rawJson   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  project   Project  @relation(fields: [projectId], references: [id])

  playlist       PlaylistItem[]
  sounds         Sound[]
  steps          Step[]
  lightChannels  GlobalLightChannel[]
  lightPlot      GlobalLightPlot[]
  theaterLayout  TheaterLayout?
}

model PlaylistItem {
  id        String @id @default(cuid())
  sceneId   String
  order     Int
  sourceId  Int
  title     String
  file      String
  fadeMs    Int
  loop      Boolean

  scene     Scene  @relation(fields: [sceneId], references: [id])
}

model Sound {
  id        String @id @default(cuid())
  sceneId   String
  sourceId  Int
  title     String
  file      String
  icon      String?
  volume    Float
  fadeMs    Int
  loop      Boolean

  scene     Scene  @relation(fields: [sceneId], references: [id])
}

model Step {
  id           String   @id @default(cuid())
  sceneId      String
  sourceId     Int
  title        String
  markdown     String?
  playMarkdown String?
  order        Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  scene        Scene    @relation(fields: [sceneId], references: [id])

  requisites        StepRequisite[]
  lightPlot         StepLightPlot[]
  theaterModels     TheaterModel[]
  theaterSpotlights TheaterSpotlight[]
}

model StepRequisite {
  id       String @id @default(cuid())
  stepId   String
  sourceId Int
  label    String
  checked  Boolean @default(false)

  step     Step   @relation(fields: [stepId], references: [id])
}

model StepLightPlot {
  id       String @id @default(cuid())
  stepId   String
  sourceId Int
  label    String
  channel  String?
  x        Int
  y        Int
  angle    Int
  length   Int

  step     Step   @relation(fields: [stepId], references: [id])
}

model TheaterModel {
  id              String   @id @default(cuid())
  stepId          String
  sourceId        Int
  name            String
  type            String
  builtin         String?
  allowOutOfBounds Boolean @default(false)
  position        Json
  rotation        Json
  scale           Json

  step            Step    @relation(fields: [stepId], references: [id])
}

model TheaterSpotlight {
  id        String  @id @default(cuid())
  stepId    String
  sourceId  Int
  label     String
  position  Json
  target    Json
  angleDeg  Int
  intensity Float
  color     String
  enabled   Boolean
  channel   Int
  isRgb     Boolean

  step      Step    @relation(fields: [stepId], references: [id])
}

model GlobalLightChannel {
  id      String  @id @default(cuid())
  sceneId String
  raw     String
  index   Int

  scene   Scene   @relation(fields: [sceneId], references: [id])
}

model GlobalLightPlot {
  id       String @id @default(cuid())
  sceneId  String
  sourceId Int
  label    String
  channel  String
  x        Int
  y        Int
  angle    Int
  length   Int

  scene    Scene  @relation(fields: [sceneId], references: [id])
}

model TheaterLayout {
  id             String @id @default(cuid())
  sceneId        String @unique
  hallWidth      Int
  hallDepth      Int
  wallHeight     Int
  stageWidth     Int
  stageDepth     Int
  stageHeight    Int
  stageZ         Int
  audienceStartZ Int
  seatRows       Int
  seatsPerRow    Int
  seatSpacing    Float
  rowSpacing     Float
  aisleWidth     Float
  aisleCenterX   Float
  doorWidth      Float
  doorHeight     Float
  doorZ          Float
  rowRise        Float

  scene          Scene  @relation(fields: [sceneId], references: [id])
}

model ProjectModelFile {
  id         String  @id @default(cuid())
  projectId  String
  fileName   String
  path       String
  uploadedAt DateTime @default(now())

  project    Project @relation(fields: [projectId], references: [id])
}

model BotSettings {
  id                String   @id @default("singleton")
  groupChatId       String?  // ID группы Telegram для опросов
  attendanceThreadId String? // ID топика для опросов о явке
  announcementsThreadId String? // ID топика для объявлений
  projectSlug       String?  // Slug проекта по умолчанию для бота
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}