# URL API для браузера.
# Локально (npm run dev на хосте): обычно полный URL бэка.
#   VITE_API_BASE_URL=http://localhost:3000
# Docker compose dev (orkestr-web): в compose уже задано VITE_API_BASE_URL=/api — браузер ходит на тот же origin + /api.
#   Не задавайте здесь LAN-IP (192.168.x.x) только для «доступа с телефона»: прокси Vite крутится ВНУТРИ контейнера
#   и до этого IP не достучится → ECONNREFUSED. Для прокси в Docker по умолчанию используется http://back:3000
#   (см. vite.config.ts и DEV_PROXY_API в docker-compose.dev.yml).

VITE_API_BASE_URL=http://localhost:3000
