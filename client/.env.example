## TicketsCloud widget (Zaklyatie page)
# Take values from TicketsCloud event -> "Виджет" settings
REACT_APP_TC_ZAKLYATIE_EVENT_ID=
REACT_APP_TC_ZAKLYATIE_TOKEN=

## Zaklyatie rain ambience (audio file URL)
# Put file into client/public/audio/zaklyatie-rain.mp3
# Or set an absolute URL (must allow CORS if external)
REACT_APP_ZAKLYATIE_RAIN_URL=/audio/zaklyatie-rain.mp3

