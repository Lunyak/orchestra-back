# Dev-сервер CRA (react-scripts). Контекст сборки — корень репозитория.
FROM node:22-alpine

WORKDIR /workspace/client

COPY client/package.json client/package-lock.json ./

EXPOSE 3000

ENV HOST=0.0.0.0
ENV PORT=3000
ENV BROWSER=none
ENV CHOKIDAR_USEPOLLING=true
ENV WATCHPACK_POLLING=true

CMD ["sh", "-c", "npm install --no-audit --fund=false && exec npm start"]
