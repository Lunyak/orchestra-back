# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
ADMIN_ID=your_admin_telegram_id
OWNER_TELEGRAM_ID=your_owner_telegram_id

# Group Chat Configuration
GROUP_CHAT_ID=-1001234567890
# Optional: message_thread_id (topics). Leave empty to post into main chat.
GROUP_CHAT_ID_ATTENTION=
# Optional: message_thread_id (topics) for director sessions публикаций.
# Leave empty to post into main chat.
DIRECTOR_SESSIONS_THREAD_ID=
ANNOUNCEMENTS_THREAD_ID=14434

# Google Sheets Configuration
SPREADSHEET_ID=your_spreadsheet_id_here

# Backend Server URL (internal Docker network)
SERVER_URL=back:3000

# Secret для доступа к backend /bot/* эндпоинтам
BOT_SECRET=change-me

# Which Telegram bot integration (from Orchestra UI) this bot-service represents.
# Used as header X-Telegram-Bot-Integration-Id for backend /bot/* endpoints.
TELEGRAM_BOT_INTEGRATION_ID=your_integration_id_here

# Единственный внутренний секрет для server-to-server:
# - back -> bot runner (/internal/publish-*)
# - bot runner -> back (/internal/telegram-bots/*)
INTERNAL_API_SECRET=change-me-internal

# Health Check Port
HEALTH_PORT=3001
