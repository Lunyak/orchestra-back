# Environment Variables для Orchestra Services
# Скопируйте этот файл в .env и задайте реальные значения

# ============================================
# JWT & Security (ОБЯЗАТЕЛЬНО для production!)
# ============================================
# Используйте длинные случайные строки (минимум 32 символа)
# Генерация: openssl rand -base64 32
JWT_SECRET=change-me-in-production-use-long-random-string-min-32-chars
ADMIN_SECRET=change-admin-secret-use-long-random-string
BOT_SECRET=change-bot-secret-use-long-random-string

# ============================================
# Telegram Bot
# ============================================
# BOT_TOKEN получите у @BotFather в Telegram
# OWNER_TELEGRAM_ID - ваш ID в Telegram (можно узнать у @userinfobot)
BOT_TOKEN=your_telegram_bot_token_from_botfather
OWNER_TELEGRAM_ID=your_telegram_user_id

# ============================================
# Admin Panel (Vite build-time variables)
# ============================================
VITE_API_BASE_URL=/api
VITE_LINK_WEB_LOCAL=http://localhost:5173
VITE_LINK_WEB_SERVER=http://213.226.126.196
VITE_LINK_MINIO=http://213.226.126.196:9001
VITE_LINK_DOZZLE=http://213.226.126.196:9999

# ============================================
# Database (настроено в docker-compose.yml)
# ============================================
# Эти значения уже заданы в docker-compose.yml
# Раскомментируйте только если нужно переопределить
# DATABASE_URL=postgresql://orkestr:orkestr_secret@postgres:5432/dophamin_orkestr

# ============================================
# S3/MinIO Storage
# ============================================
# Настроено в docker-compose.yml для локальной разработки
# На production измените на ваш MinIO/S3 сервер
# S3_ENDPOINT=http://213.226.126.196:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY=orchestra
# S3_SECRET_KEY=orchestra_secret
# S3_BUCKET=orchestra-media

# ============================================
# Deployment (для GitLab CI/CD)
# ============================================
# Эти переменные задаются в GitLab UI (Settings → CI/CD → Variables)
# SSH_PRIVATE_KEY=<ваш приватный SSH ключ>
# DEPLOY_HOST=213.226.126.196
# DEPLOY_USER=root
# DEPLOY_PATH=/opt/orchestra-back
