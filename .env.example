# ============================================
# JWT & Security
# ============================================
JWT_SECRET=change-me-in-production-use-long-random-string-min-32-chars
ADMIN_SECRET=change-admin-secret-use-long-random-string
BOT_SECRET=change-bot-secret-use-long-random-string

# ============================================
# Telegram Bot
# ============================================
# ВАЖНО: Замените эти значения на свои!
# BOT_TOKEN - токен от @BotFather
# OWNER_TELEGRAM_ID - ваш Telegram ID (узнать: @userinfobot)
BOT_TOKEN=your_telegram_bot_token_from_botfather
OWNER_TELEGRAM_ID=your_telegram_user_id

# Группы и чаты
GROUP_CHAT_ID=-1001234567890
# Optional: message_thread_id (topics). Leave empty to post into main chat.
GROUP_CHAT_ID_ATTENTION=
# Optional: message_thread_id (topics) for director sessions публикаций.
# Leave empty to post into main chat.
DIRECTOR_SESSIONS_THREAD_ID=
ANNOUNCEMENTS_THREAD_ID=14434

# Google Sheets (для гостевого списка и др.)
SPREADSHEET_ID=your_google_spreadsheet_id

# ============================================
# Admin Panel (Vite build-time variables)
# ============================================
VITE_API_BASE_URL=/api
# Только для локального «npm run dev» в admin (не Docker): прокси /api и /minio
# VITE_API_BASE_URL=http://localhost:3000
# VITE_MINIO_PROXY_TARGET=http://localhost:9000
VITE_LINK_WEB_LOCAL=http://localhost:5173
VITE_LINK_WEB_SERVER=http://213.226.126.196
VITE_LINK_MINIO=http://213.226.126.196:9001
VITE_LINK_DOZZLE=http://213.226.126.196:9999

# ============================================
# HTTPS Gateway (Caddy, Let's Encrypt)
# ============================================
# Укажите email для Let's Encrypt и домены (A-записи должны указывать на ваш VPS).
# Примеры:
#   WEB_DOMAIN=orchestra.example.com
#   ADMIN_DOMAIN=admin.orchestra.example.com
#   ACME_EMAIL=admin@example.com
# Локально для ссылок в письмах: WEB_DOMAIN=localhost:5173 и APP_BASE_PATH=/
WEB_DOMAIN=
# Префикс SPA на проде. Письмо сброса: https://{WEB_DOMAIN}/orkestr/reset-password?token=...
APP_BASE_PATH=/orkestr
ADMIN_DOMAIN=
ACME_EMAIL=

# ============================================
# SMTP Яндекс (сброс пароля с бэкенда)
# ============================================
# Пароль приложения: https://id.yandex.ru/security/app-passwords
# MAIL_FROM должен быть тем же ящиком, что SMTP_USER
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Orchestra <name@yandex.ru>"

# ЮKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
BILLING_STANDARD_PRICE_RUB=990
BILLING_PREMIUM_PRICE_RUB=2990

# Database (if running locally)
# DATABASE_URL=postgresql://orkestr:orkestr_secret@localhost:5432/dophamin_orkestr

# S3/MinIO Configuration (adjust based on your setup)
MINIO_ROOT_USER=orchestra
MINIO_ROOT_PASSWORD=orchestra_secret

S3_ENDPOINT=http://213.226.126.196:9000
# Для HTTPS-приложения НЕ используйте http://...:9000, иначе браузер заблокирует аудио (Mixed Content).
# Рекомендованный вариант: проксировать MinIO через Caddy по пути /minio.
# Тогда:
#   S3_PUBLIC_URL=https://<ваш_домен>/minio
S3_PUBLIC_URL=http://213.226.126.196:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=orchestra
S3_SECRET_KEY=orchestra_secret
S3_BUCKET=orchestra-media

# Theater GLB на проде (build-arg web). Обычно: {S3_PUBLIC_URL}/{S3_BUCKET}
# HTTPS: https://<WEB_DOMAIN>/minio/orchestra-media
# Пусто = раздача из web/public/theater (локальный dev / desktop).
# Сначала: make push-theater-assets (или node scripts/push-theater-assets-to-minio.cjs)
VITE_THEATER_ASSETS_BASE_URL=http://213.226.126.196:9000/orchestra-media

# Web Admin Links (for admin panel)
# VITE_API_BASE_URL=/api
# VITE_LINK_WEB_LOCAL=http://localhost:5173
# VITE_LINK_WEB_SERVER=http://213.226.126.196
# VITE_LINK_MINIO=http://213.226.126.196:9001
# VITE_LINK_DOZZLE=http://213.226.126.196:9999
