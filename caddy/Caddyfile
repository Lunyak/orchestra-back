{
	# Email for Let's Encrypt (ACME). Put it into .env as ACME_EMAIL=you@example.com
	email {$ACME_EMAIL}
}

# Main web app (SPA). API is available under /api/* and is forwarded to the backend without /api prefix.
{$WEB_DOMAIN} {
	encode gzip zstd

	handle_path /api/* {
		reverse_proxy back:3000
	}

	handle {
		reverse_proxy web:80
	}
}

# Admin panel (separate UI). Same /api/* forwarding.
{$ADMIN_DOMAIN} {
	encode gzip zstd

	handle_path /api/* {
		reverse_proxy back:3000
	}

	handle {
		reverse_proxy admin:80
	}
}

