# Main web app (SPA). API is available under /api/* and is forwarded to the backend without /api prefix.
{$WEB_DOMAIN:localhost} {
	encode gzip zstd

	handle_path /api/* {
		reverse_proxy back:3000
	}

	# socket.io (realtime updates)
	handle_path /socket.io/* {
		reverse_proxy back:3000
	}

	# HTTPS прокси к MinIO S3 API (нужно, чтобы браузер не блокировал аудио как Mixed Content).
	# Если S3_PUBLIC_URL выставлен в https://<web-domain>/minio, то ссылки будут вида:
	#   https://<web-domain>/minio/<bucket>/<key>
	handle_path /minio/* {
		reverse_proxy minio:9000
	}

	# Orchestra app is hosted under /orkestr (safe ASCII path).
	redir /orkestr /orkestr/ 308
	handle_path /orkestr/* {
		reverse_proxy web:80
	}

	handle {
		# Main marketing site from ./client
		reverse_proxy site:80
	}
}

# Admin panel (separate UI). Same /api/* forwarding.
{$ADMIN_DOMAIN:admin.localhost} {
	encode gzip zstd

	handle_path /api/* {
		reverse_proxy back:3000
	}

	handle_path /minio/* {
		reverse_proxy minio:9000
	}

	handle {
		reverse_proxy admin:80
	}
}

