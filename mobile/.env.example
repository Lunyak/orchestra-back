# Скопируйте в ../web/.env.mobile перед сборкой (или задайте в shell):
# VITE_API_BASE_URL — полный URL API (не /api относительный путь).
# Пример для VPS:
#   VITE_API_BASE_URL=http://213.226.126.196:3000
# Если API за nginx на 443:
#   VITE_API_BASE_URL=https://213.226.126.196/api

VITE_API_BASE_URL=http://213.226.126.196:3000
VITE_CAPACITOR=1
